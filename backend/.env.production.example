# Production Environment Variables Example
NODE_ENV=production
PORT=3000

# MongoDB Atlas Connection String
# Replace <password> and <dbName> with your Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.   et/bankSystem?retryWrites=true&w=majority

# Redis Cloud URL (e.g., Upstash or Redis Labs)
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://default:yourpassword@your-redis-host.upstash.io:6379

# JWT Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_production_key_12345
